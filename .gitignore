# Downloaded official c2patool release binary — not committed; scripts/
# re-download deterministically and record the exact version in
# fixtures/README.md instead of vendoring a binary into git.
/tools/c2patool/

# scripts/build-fixtures.mjs's scratch working directory (resolved
# manifests with local absolute cert paths, per-run provenance notes) —
# never source, always regenerated, removed at the start of every run.
/fixtures/.work/

# scripts/verify-favicon-16px.mjs's rasterized output — a verification
# artifact to look at while running the script, not source.
/scripts/.favicon-check/

# Auto-generated by `next dev` itself (node_modules/next/dist/server/lib/
# generate-agent-files.js) every time the dev server starts — not source.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Build artifact: copied from node_modules by scripts/copy-c2pa-wasm.mjs,
# part of `pnpm run build` / apps/web's `predev` — never hand-edited,
# always regenerated (same discipline as graticule's public/worker/).
/apps/web/public/c2pa/

# Build artifact: copied from fixtures/ by scripts/copy-fixtures.mjs so
# the Gallery of Limits can serve them same-origin. fixtures/ itself
# (committed, with fixtures/hashes.json) is the source of truth.
/apps/web/public/fixtures/
